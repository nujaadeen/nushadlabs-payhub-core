# Copy this file to `.env` and fill in real values. `.env` itself is
# gitignored - never commit real credentials.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=payhub
DB_USER=payhub
DB_PASSWORD=payhub
DB_HOST=localhost
DB_PORT=5432

# Origins allowed to call this API cross-origin from a browser (see
# CORS_ALLOWED_ORIGINS in settings.py) - covers both VS Code "Live Server"
# (port 5500) and `python -m http.server` (port 8080) for demo.html.
# Comma-separated, no spaces; add your own if you serve demo.html from a
# different port and restart the Django server afterward.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080
